# Test environment - Database configuration
# Copy this file to `.env.test` (gitignored) and put the real passwords in.
#
# STEP 2C.2F — there is exactly ONE approved integration-test target:
#   127.0.0.1:3308/restaurant_app_test_v3   as user `restaurant_test_v3`
#
# `tests/setup.ts` enforces it FAIL-CLOSED before any Prisma client is created:
#   * both URLs below must be present and must resolve to the SAME target;
#   * scheme must be `mysql:`, host must be `127.0.0.1` (`localhost` is rejected —
#     it can resolve to ::1 or to a different daemon), port must be `3308`;
#   * database must be `restaurant_app_test_v3`, user must be `restaurant_test_v3`;
#   * protected names (`restaurant_app`, `restaurant_app_test`,
#     `restaurant_app_test_v2`, `production`, `main`, `app`) and protected ports
#     (3306 = shared host MariaDB, 3307 = sibling project) are rejected by name and
#     by port;
#   * missing / empty / ambiguous values are a refusal, not a warning.
# Never commit real credentials, and never print them in logs.

# Isolated, disposable integration-test database (ACTIVE target).
TEST_DATABASE_URL="mysql://restaurant_test_v3:<password>@127.0.0.1:3308/restaurant_app_test_v3"
DATABASE_URL="mysql://restaurant_test_v3:<password>@127.0.0.1:3308/restaurant_app_test_v3"

# Test environment - NOT production
NODE_ENV=test

# --- Inert / unused -----------------------------------------------------------
# Kept only so a rollback to the legacy target is a two-line swap. These databases
# are preserved read-only: the v1 `[F-4]` hybrid and the failed v2 provisioning
# attempt are evidence and must not be written to.
LEGACY_TEST_V1_URL="mysql://restaurant_test:<password>@127.0.0.1:3308/restaurant_app_test"
DISPOSABLE_TEST_V2_URL="mysql://restaurant_test_v2:<password>@127.0.0.1:3308/restaurant_app_test_v2"
DISPOSABLE_TEST_V3_URL="mysql://restaurant_test_v3:<password>@127.0.0.1:3308/restaurant_app_test_v3"
