# Database — local development (replace the password; URL-encode special
# characters such as @, :, /, ?, # and % in the password).
DATABASE_URL="mysql://restaurant:change-this-local-password@127.0.0.1:3306/restaurant_app"

# Docker Compose MySQL — only needed when using `docker compose up --build`.
# Keep MYSQL_USER / MYSQL_PASSWORD in sync with DATABASE_URL above. Docker
# uses the service hostname `mysql` internally; Compose constructs that URL
# for the app, worker, and migration runner automatically.
MYSQL_ROOT_PASSWORD="change-this-root-password"
MYSQL_DATABASE="restaurant_app"
MYSQL_USER="restaurant"
MYSQL_PASSWORD="change-this-local-password"

# Test Database (for integration tests only)
# REQUIRED for running integration tests. Must be a separate, isolated database.
# Example: TEST_DATABASE_URL="mysql://test_user:test_pass@localhost:3306/restaurant_app_test"
# The test bootstrap will reject:
#   - Missing TEST_DATABASE_URL
#   - TEST_DATABASE_URL == DATABASE_URL
#   - NODE_ENV=production
#   - Database names without '_test' suffix (warning only)
TEST_DATABASE_URL=

# Auth.js
NEXTAUTH_SECRET="your-secret-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
# Set this when the app is behind a reverse proxy / deployed domain.
AUTH_TRUST_HOST=false

# iPaymu Payment Gateway
# ------------------------------------------------------------------
# Each running app selects one gateway environment with IPAYMU_ENV (or the
# legacy IPAYMU_ENVIRONMENT). Sandbox and production credentials can both be
# configured without replacing each other. Run the local/staging app with
# IPAYMU_ENV=sandbox and keep the live app configured with IPAYMU_ENV=production.
#
#   Sandbox (local development / testing):
#     IPAYMU_ENV=sandbox
#     IPAYMU_SANDBOX_VA=<sandbox VA from https://sandbox.ipaymu.com/integration>
#     IPAYMU_SANDBOX_API_KEY=<sandbox API key>
#
#   Production (go-live):
#     IPAYMU_ENV=production
#     IPAYMU_PRODUCTION_VA=<live VA from https://my.ipaymu.com/integration>
#     IPAYMU_PRODUCTION_API_KEY=<live API key>
#
# Old IPAYMU_VA / IPAYMU_API_KEY variables are still accepted as fallbacks
# for whichever environment IPAYMU_ENV selects. Prefer the mode-specific keys
# above when both environments are configured.
IPAYMU_ENV=sandbox
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_SANDBOX_VA=
IPAYMU_SANDBOX_API_KEY=
IPAYMU_PRODUCTION_VA=
IPAYMU_PRODUCTION_API_KEY=
# Optional endpoint overrides, normally leave these unset:
# IPAYMU_SANDBOX_BASE_URL=https://sandbox.ipaymu.com/api/v2
# IPAYMU_PRODUCTION_BASE_URL=https://my.ipaymu.com/api/v2

# WhatsApp (Baileys)
# Canonical session-dir variable (M8). WHATSAPP_SESSION_PATH is still honored
# as a legacy alias by the Baileys provider, but new configs should use DIR.
# Precedence in the provider:
#   WHATSAPP_SESSION_DIR || WHATSAPP_SESSION_PATH || "/app/whatsapp-session"
# Do not set both: keep WHATSAPP_SESSION_DIR active and leave PATH unset.
WHATSAPP_SESSION_DIR="./whatsapp-session"
# Legacy alias (kept for compatibility only; DIR wins when both are set):
# WHATSAPP_SESSION_PATH="./whatsapp-session"

# Product image upload storage (physical root for /uploads/products/... files)
# ------------------------------------------------------------------
# Optional. Default (empty/unset): <project>/uploads/products — used by the
# Docker deployment (volume-mounted at /app/uploads).
#
# LOCAL DEVELOPMENT: point this OUTSIDE the `next dev` (Turbopack) watched
# tree — a runtime upload inside the project triggers a full browser reload
# of every open tab. `.runtime-data/` is gitignored and not watched:
PRODUCT_UPLOAD_DIR=".runtime-data/uploads/products"

# Restaurant branding logo storage (physical root for /uploads/branding/...
# files). Same rules as PRODUCT_UPLOAD_DIR — default <project>/uploads/branding
# (Docker volume mount), local dev should use a gitignored path:
BRANDING_UPLOAD_DIR=".runtime-data/uploads/branding"

# Redis
REDIS_URL="redis://localhost:6379"

# App
# MUST be the public HTTPS origin in production — it is used to build the
# iPaymu webhook URL (https://YOUR_DOMAIN/api/webhooks/ipaymu) and the
# return/cancel URLs. E.g. NEXT_PUBLIC_APP_URL="https://resto.example.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Customer session signing (F3 promo). Optional — falls back to
# AUTH_SECRET / NEXTAUTH_SECRET when unset. Use a separate secret in
# production so a staff-session leak cannot forge customer tokens:
# CUSTOMER_SESSION_SECRET="change-me"

# Seed data — optional. Only used by `npm run db:seed`; never keep the default
# passwords when the database is not disposable.
SEED_CASHIER_PASSWORD="change-this-seed-password"
