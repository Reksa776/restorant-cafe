# Database
DATABASE_URL="mysql://root:password@localhost:3306/restaurant_app"

# Auth.js
NEXTAUTH_SECRET="your-secret-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# iPaymu Payment Gateway
# ------------------------------------------------------------------
# Environment selection — either variable works; "production" selects
# https://my.ipaymu.com/api/v2, anything else uses the sandbox endpoint
# https://sandbox.ipaymu.com/api/v2.
#
#   Sandbox (local development / testing):
#     IPAYMU_ENV=sandbox
#     IPAYMU_VA=<sandbox VA from https://sandbox.ipaymu.com/integration>
#     IPAYMU_API_KEY=<sandbox API key>
#
#   Production (go-live):
#     IPAYMU_ENV=production            (or IPAYMU_ENVIRONMENT=production)
#     IPAYMU_VA=<production VA from https://my.ipaymu.com/integration>
#     IPAYMU_API_KEY=<production API key>
#
# Optional explicit endpoint override (takes effect only when the env name
# above is NOT "production", so a stale sandbox URL can never disable live):
#   IPAYMU_BASE_URL=https://my.ipaymu.com/api/v2       # production
#   IPAYMU_BASE_URL=https://sandbox.ipaymu.com/api/v2  # sandbox
IPAYMU_ENV=sandbox
IPAYMU_VA=
IPAYMU_API_KEY=

# WhatsApp (Baileys)
WHATSAPP_SESSION_PATH="./whatsapp-session"

# Redis
REDIS_URL="redis://localhost:6379"

# App
# MUST be the public HTTPS origin in production — it is used to build the
# iPaymu webhook URL (https://YOUR_DOMAIN/api/webhooks/ipaymu) and the
# return/cancel URLs. E.g. NEXT_PUBLIC_APP_URL="https://resto.example.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
