// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  CASHIER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

// ============================================================
// PURCHASING & INVENTORY — Phase B foundation decisions
//
// D1 — unit: quantities are integer PCS (no unit/packaging model yet).
// D2 — cost: historical unit cost is stored ONLY on PurchaseItem.unitCost;
//      Product.price (selling price) is never touched.
// D4 — stock: OUT movements are written only when an Order reaches
//      COMPLETED (order.service updateOrderStatus), never at PAID.
// ============================================================

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum NotificationType {
  ORDER_RECEIVED
  ORDER_CONFIRMED
  ORDER_PROCESSING
  ORDER_COMPLETED
  ORDER_CANCELLED
  PAYMENT_REQUEST
  PAYMENT_SUCCESS
  PAYMENT_FAILED
}

// ============================================================
// MODELS
// ============================================================

model User {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  email        String   @unique
  password     String
  role         Role     @default(ADMIN)
  isActive     Boolean  @default(true)
  // Bumped on password change / deactivation; JWTs carry the version from
  // sign-in time and are rejected when it no longer matches (session
  // revocation, M3).
  sessionVersion Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id])
  orderHistory OrderStatusHistory[]
  cashierShifts CashierShift[]
  auditLogs    AuditLog[]
  branchAssignments UserBranch[]
  shiftOverridesRequested ShiftOverride[] @relation("ShiftOverrideRequester")
  shiftOverridesApproved  ShiftOverride[] @relation("ShiftOverrideApprover")
  shiftOverridesRejected  ShiftOverride[] @relation("ShiftOverrideRejecter")
  refundsRequested Refund[] @relation("RefundRequester")
  refundsApproved  Refund[] @relation("RefundApprover")
  refundsRejected  Refund[] @relation("RefundRejecter")
  cancellationsRequested CancellationRequest[] @relation("CancellationRequester")
  cancellationsApproved  CancellationRequest[] @relation("CancellationApprover")
  cancellationsRejected  CancellationRequest[] @relation("CancellationRejecter")
  stockMovements StockMovement[]

  @@map("user")
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  branches     Branch[]
  tables       Table[]
  categories   Category[]
  products     Product[]
  customers    Customer[]
  orders       Order[]
  payments     Payment[]
  cashierShifts CashierShift[]
  shiftOverrides ShiftOverride[]
  refunds      Refund[]
  cancellations CancellationRequest[]
  auditLogs    AuditLog[]
  promos       Promo[]
  settings     RestaurantSettings?
  productRecommendations ProductRecommendation[]
  suppliers    Supplier[]
  purchases    Purchase[]
  stockMovements StockMovement[]

  @@map("restaurant")
}

model Branch {
  id           String   @id @default(cuid())
  restaurantId String
  code         String
  name         String
  address      String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables     Table[]
  orders     Order[]
  payments   Payment[]
  shifts     CashierShift[]
  products   BranchProduct[]
  users      UserBranch[]
  promos     Promo[]
  promoUsages PromoUsage[]
  notifications Notification[]
  purchases  Purchase[]
  stockMovements StockMovement[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@index([isActive])

  @@map("branch")
}

model UserBranch {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])

  @@map("userbranch")
}

model BranchProduct {
  id            String   @id @default(cuid())
  branchId      String
  productId     String
  isAvailable   Boolean  @default(true)
  priceOverride Decimal? @db.Decimal(10, 2)
  // Per-branch inventory quantity (inventory count managed by staff/admin).
  // Orders/payments do NOT auto-decrement this; it is a manual stock level.
  stock         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])

  @@map("branchproduct")
}

// One branding configuration per restaurant (unique restaurantId). All
// fields nullable: when unset, the app falls back to Restaurant.name and the
// default theme colors, so existing restaurants keep working untouched.
model RestaurantSettings {
  id             String   @id @default(cuid())
  restaurantId   String   @unique
  // Website/brand display name; null → Restaurant.name
  siteName       String?
  // Locally managed upload: /uploads/branding/<restaurantId>/<uuid>.<ext>
  logoUrl        String?
  // Validated #RRGGBB hex values; null → default theme colors
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])

  @@map("restaurantsettings")
}

model CashierShift {
  id           String      @id @default(cuid())
  restaurantId String
  branchId     String?
  userId       String
  shiftNumber  String
  openingCash  Decimal     @db.Decimal(12, 2)
  closingCash  Decimal?    @db.Decimal(12, 2)
  expectedCash Decimal?    @db.Decimal(12, 2)
  difference   Decimal?    @db.Decimal(12, 2)
  notes        String?     @db.Text
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  status       ShiftStatus @default(OPEN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user       User       @relation(fields: [userId], references: [id])
  payments   Payment[]
  refunds    Refund[]
  overrides  ShiftOverride[]

  @@unique([restaurantId, shiftNumber])
  @@index([restaurantId])
  @@index([branchId])
  @@index([userId])
  @@index([status])

  @@map("cashiershift")
}

model ShiftOverride {
  id                    String        @id @default(cuid())
  restaurantId          String
  branchId              String?
  shiftId               String
  requestedByCashierId  String
  reason                String        @db.Text
  proposedClosingCash   Decimal?      @db.Decimal(12, 2)
  status                RequestStatus @default(PENDING)
  approvedByAdminId     String?
  rejectedByAdminId     String?
  decisionNote          String?       @db.Text
  requestedAt           DateTime      @default(now())
  decidedAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id])
  shift      CashierShift @relation(fields: [shiftId], references: [id])
  requester  User         @relation("ShiftOverrideRequester", fields: [requestedByCashierId], references: [id])
  approver   User?        @relation("ShiftOverrideApprover", fields: [approvedByAdminId], references: [id])
  rejecter   User?        @relation("ShiftOverrideRejecter", fields: [rejectedByAdminId], references: [id])

  @@index([restaurantId])
  @@index([branchId])
  @@index([shiftId])
  @@index([status])

  @@map("shiftoverride")
}

model Refund {
  id                    String        @id @default(cuid())
  restaurantId          String
  branchId              String?
  orderId               String
  paymentId             String?
  shiftId               String?
  amount                Decimal       @db.Decimal(12, 2)
  reason                String        @db.Text
  status                RequestStatus @default(PENDING)
  requestedByCashierId  String
  approvedByAdminId     String?
  rejectedByAdminId     String?
  decisionNote          String?       @db.Text
  requestedAt           DateTime      @default(now())
  decidedAt             DateTime?
  approvedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id])
  order      Order            @relation(fields: [orderId], references: [id])
  payment    Payment?         @relation(fields: [paymentId], references: [id])
  shift      CashierShift?    @relation(fields: [shiftId], references: [id])
  requester  User             @relation("RefundRequester", fields: [requestedByCashierId], references: [id])
  approver   User?            @relation("RefundApprover", fields: [approvedByAdminId], references: [id])
  rejecter   User?            @relation("RefundRejecter", fields: [rejectedByAdminId], references: [id])

  @@index([restaurantId])
  @@index([branchId])
  @@index([orderId])
  @@index([paymentId])
  @@index([status])
  @@index([shiftId])

  @@map("refund")
}

model CancellationRequest {
  id                    String        @id @default(cuid())
  restaurantId          String
  branchId              String?
  orderId               String
  reason                String        @db.Text
  status                RequestStatus @default(PENDING)
  requestedByCashierId  String
  approvedByAdminId     String?
  rejectedByAdminId     String?
  decisionNote          String?       @db.Text
  requestedAt           DateTime      @default(now())
  decidedAt             DateTime?
  approvedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  order      Order      @relation(fields: [orderId], references: [id])
  requester  User       @relation("CancellationRequester", fields: [requestedByCashierId], references: [id])
  approver   User?      @relation("CancellationApprover", fields: [approvedByAdminId], references: [id])
  rejecter   User?      @relation("CancellationRejecter", fields: [rejectedByAdminId], references: [id])

  @@index([restaurantId])
  @@index([branchId])
  @@index([orderId])
  @@index([status])

  @@map("cancellationrequest")
}

model AuditLog {
  id           String   @id @default(cuid())
  restaurantId String
  branchId     String?
  userId       String?
  action       String
  entityType   String?
  entityId     String?
  details      Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])

  @@index([restaurantId])
  @@index([branchId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])

  @@map("auditlog")
}


model Table {
  id           String      @id @default(cuid())
  restaurantId String
  branchId     String?
  number       Int
  name         String
  capacity     Int         @default(4)
  status       TableStatus @default(AVAILABLE)
  qrCode       String?     @db.Text
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orders     Order[]

  // Multi-branch (Phase M3): a table number is unique per branch, not per
  // restaurant — Jakarta Table 01 can exist alongside Bandung Table 01.
  // Nullable branchId rows (legacy) keep working: MySQL unique indexes allow
  // multiple NULLs in the branchId column.
  @@unique([restaurantId, branchId, number])
  @@index([restaurantId])
  @@index([branchId])
  @@index([status])

  @@map("table")
}

model Category {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String?  @db.Text
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  products   Product[]

  @@unique([restaurantId, name])
  @@index([restaurantId])

  @@map("category")
}

model Product {
  id           String   @id @default(cuid())
  restaurantId String
  categoryId   String
  name         String
  description  String?  @db.Text
  price        Decimal  @db.Decimal(10, 2)
  imageUrl     String?
  isAvailable  Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id])
  category     Category             @relation(fields: [categoryId], references: [id])
  orderItems   OrderItem[]
  optionGroups ProductOptionGroup[]
  addons       ProductAddon[]
  branchProducts BranchProduct[]
  // Admin-curated "recommend for this product" rows (F3).
  recommendationsFrom ProductRecommendation[] @relation("RecommendationSource")
  recommendationsTo   ProductRecommendation[] @relation("RecommendationTarget")
  purchaseItems PurchaseItem[]
  stockMovements StockMovement[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([isAvailable])

  @@map("product")
}

// ============================================================
// PRODUCT RECOMMENDATION (F3) — admin-curated, tenant-scoped.
//
// Meaning: "product A (productId) manually recommends product B
// (recommendedProductId)". ONE row per pair — the (restaurantId,
// productId, recommendedProductId) unique constraint keeps the pair
// unique. sortOrder controls display order; isActive lets an admin
// disable a recommendation without deleting it.
//
// Public tier (highest priority first):
//   1. MANUAL admin recommendations (this model, active only)
//   2. Personalized (customer favorites)
//   3. Frequently bought together
//   4. Best sellers
//   5. Active product fallback
// ============================================================

model ProductRecommendation {
  id                  String   @id @default(cuid())
  restaurantId        String
  productId           String
  recommendedProductId String
  sortOrder           Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  product    Product    @relation("RecommendationSource", fields: [productId], references: [id], onDelete: Cascade)
  recommendedProduct Product @relation("RecommendationTarget", fields: [recommendedProductId], references: [id], onDelete: Cascade)

  // Explicit short name: MySQL limits identifiers to 64 chars and the
  // auto-generated name exceeds it (P3018 / error 1059).
  @@unique([restaurantId, productId, recommendedProductId], map: "product_reco_unique")
  @@index([restaurantId])
  @@index([productId])
  @@index([recommendedProductId])

  @@map("productrecommendation")
}

model Customer {
  id           String   @id @default(cuid())
  restaurantId String
  name         String?
  phone        String?
  whatsappId   String?
  // Customer login (F3 promo). Nullable so existing guest-only customers
  // keep working untouched; email is unique per restaurant when set.
  email        String?
  password     String? // bcrypt hash; null = customer has no login yet
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant  Restaurant  @relation(fields: [restaurantId], references: [id])
  orders      Order[]
  promoUsages PromoUsage[]

  @@unique([restaurantId, phone])
  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@index([phone])

  @@map("customer")
}

model Order {
  id            String        @id @default(cuid())
  restaurantId  String
  branchId      String?
  orderNumber   String
  customerId    String
  tableId       String?
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  serviceCharge Decimal       @default(0) @db.Decimal(10, 2)
  grandTotal    Decimal       @db.Decimal(10, 2)
  orderType     OrderType     @default(DINE_IN)
  visitorCount  Int?
  notes         String?       @db.Text
  notifiedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id])
  branch        Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer      Customer             @relation(fields: [customerId], references: [id])
  table         Table?               @relation(fields: [tableId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  refunds       Refund[]
  cancellations CancellationRequest[]
  // Promo applied to this order (F3) — null when no promo was used.
  promoId       String?
  promoCode     String?
  promo         Promo?               @relation(fields: [promoId], references: [id])
  promoUsages   PromoUsage[]

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId])
  @@index([branchId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  // Customer lookup for stats/aggregations (LOW-8).
  @@index([customerId])

  @@map("order")
}

model ProductOptionGroup {
  id         String   @id @default(cuid())
  productId  String
  name       String
  type       String   @default("SINGLE") // SINGLE or MULTI
  isRequired Boolean  @default(true)
  minSelect  Int      @default(1)
  maxSelect  Int      @default(1)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@index([productId])

  @@map("productoptiongroup")
}

model ProductOption {
  id              String   @id @default(cuid())
  optionGroupId   String
  name            String
  priceAdjustment Decimal  @default(0) @db.Decimal(10, 2)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group ProductOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@index([optionGroupId])

  @@map("productoption")
}

model ProductAddon {
  id        String   @id @default(cuid())
  productId String
  name      String
  price     Decimal  @db.Decimal(10, 2)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])

  @@map("productaddon")
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(10, 2)
  totalPrice     Decimal  @db.Decimal(10, 2)
  notes          String?  @db.Text
  customizations Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])

  @@map("orderitem")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  notes     String?     @db.Text
  changedBy String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [changedBy], references: [id])

  @@index([orderId])
  @@index([status])

  @@map("orderstatushistory")
}

model Payment {
  id           String        @id @default(cuid())
  restaurantId String
  branchId     String?
  orderId      String
  // Cash drawer shift that collected this payment (KASIR only). Null for
  // online payments (QRIS/VA) and for legacy admin entries without a shift.
  shiftId      String?
  status       PaymentStatus @default(UNPAID)
  amount       Decimal       @db.Decimal(10, 2)
  method       String?
  provider     String?
  providerRef  String?
  paymentUrl   String?       @db.Text
  // Raw QR data returned by the gateway at payment-creation time (QRIS
  // channel). qrImage is the QR image (URL or data URI) from iPaymu;
  // qrString is the QR payload used only as a fallback to re-render.
  qrImage      String?       @db.Text
  qrString     String?       @db.Text
  paidAt       DateTime?
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id])
  branch       Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  order        Order                @relation(fields: [orderId], references: [id])
  shift        CashierShift?        @relation(fields: [shiftId], references: [id])
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([restaurantId])
  @@index([branchId])
  @@index([orderId])
  @@index([status])
  @@index([providerRef])
  @@index([shiftId])

  @@map("payment")
}

// ============================================================
// PROMO (F3) — tenant-scoped marketing/coupon engine.
// ============================================================

model Promo {
  id          String   @id @default(cuid())
  restaurantId String
  branchId    String?
  code        String
  name        String
  description String?  @db.Text
  type        String   @default("PERCENT") // PERCENT | FIXED
  value       Decimal  @db.Decimal(10, 2)
  minOrder    Decimal  @default(0) @db.Decimal(10, 2)
  // Cap for PERCENT promos (e.g. 10% max Rp10.000).
  maxDiscount Decimal? @db.Decimal(10, 2)
  startsAt    DateTime?
  expiresAt   DateTime?
  // Global usage quota (0 = unlimited). Enforced server-side.
  maxUsage    Int      @default(0)
  // Max times ONE customer may use this promo (0 = unlimited).
  perCustomerLimit Int  @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  usages     PromoUsage[]
  orders     Order[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@index([branchId])
  @@index([isActive])

  @@map("promo")
}

// One row per customer-promo interaction.
//  - Claim: row with orderId = null (reserves the right to use it).
//  - Use:   row with orderId set (the promo was applied to an order).
// Quota/per-customer limits are enforced with a per-promo row lock inside
// a transaction (race-safe), never from client input.
model PromoUsage {
  id         String   @id @default(cuid())
  promoId    String
  customerId String
  orderId    String?
  // Branch where the promo was claimed/used (null = legacy / restaurant-wide
  // context without a branch). Used for branch-level promo reporting.
  branchId   String?
  createdAt  DateTime @default(now())

  promo    Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  order    Order?   @relation(fields: [orderId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([promoId])
  @@index([customerId])
  @@index([orderId])
  @@index([branchId])

  @@map("promousage")
}

model PaymentTransaction {
  id        String   @id @default(cuid())
  paymentId String
  provider  String
  type      String
  status    String
  amount    Decimal  @db.Decimal(10, 2)
  rawData   Json?
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([provider])

  @@map("paymenttransaction")
}

model WhatsAppMessage {
  id           String   @id @default(cuid())
  restaurantId String
  direction    String // INCOMING | OUTGOING
  from         String
  to           String?
  messageId    String?  @unique
  content      String   @db.Text
  type         String? // text | image | etc
  status       String? // sent | delivered | read | failed
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([restaurantId])
  @@index([from])
  @@index([messageId])
  @@index([createdAt])

  @@map("whatsappmessage")
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  CONNECTING
  QR_REQUIRED
  CONNECTED
  RECONNECTING
  ERROR
}

model WhatsAppSession {
  id           String                   @id @default(cuid())
  restaurantId String                   @unique
  sessionId    String
  status       WhatsAppConnectionStatus @default(DISCONNECTED)
  phone        String? // Connected phone/JID
  lastError    String?                  @db.Text
  isActive     Boolean                  @default(true)
  lastActiveAt DateTime                 @default(now())
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([restaurantId])
  @@index([status])

  @@map("whatsappsession")
}

model Notification {
  id           String           @id @default(cuid())
  restaurantId String
  branchId     String?
  type         NotificationType
  title        String
  message      String           @db.Text
  data         Json?
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([branchId])
  @@index([isRead])
  @@index([createdAt])

  @@map("notification")
}

// ============================================================
// PURCHASING & INVENTORY — Phase B foundation models
// ============================================================

// One vendor per restaurant. Tenant-scoped (restaurantId), soft-deletable
// via isActive — never hard-deleted so purchase history stays intact.
model Supplier {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  phone        String?
  email        String?
  address      String?
  notes        String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  purchases  Purchase[]

  // Idempotency within a tenant: two different restaurants may each have a
  // supplier named the same; within ONE restaurant the name is unique.
  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([restaurantId, isActive])

  @@map("supplier")
}

// A goods-delivery/order transaction: which branch received items from which
// supplier. Status DRAFT → RECEIVED is the atomic receive transition;
// CANCELLED aborts a draft. total is server-derived from item lineTotal.
model Purchase {
  id           String         @id @default(cuid())
  restaurantId String
  branchId     String
  supplierId   String
  status       PurchaseStatus @default(DRAFT)
  receivedAt   DateTime?
  total        Decimal        @db.Decimal(12, 2)
  notes        String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])
  supplier   Supplier   @relation(fields: [supplierId], references: [id])
  items      PurchaseItem[]

  @@index([restaurantId, createdAt])
  @@index([restaurantId, branchId, createdAt])
  @@index([restaurantId, supplierId, createdAt])
  @@index([restaurantId, status])

  @@map("purchase")
}

// One purchased line: references the restaurant-level Product master (never
// BranchProduct). quantity is positive PCS; unitCost is the historical
// purchase cost (D2); lineTotal/total are server-derived, never client input.
model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
  lineTotal  Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])

  @@map("purchaseitem")
}

// Append-only stock ledger, one row per stock change.
//
// quantity semantics (documented):
//   IN          quantity > 0 — receiving goods adds stock
//   OUT         quantity < 0 — an Order reaching COMPLETED removes stock
//   ADJUSTMENT  quantity is a signed delta (+increase / -decrease)
//
// balanceAfter = the branchproduct.stock value AFTER `quantity` is applied.
// refType/refId link the movement to its source (e.g. "PURCHASE_RECEIVE" +
// purchaseId) so Phase E receiving can be double-submit safe; they are NOT
// unique because one document (a purchase) legitimately produces multiple
// movements (one per item).
model StockMovement {
  id           String            @id @default(cuid())
  restaurantId String
  branchId     String
  productId    String
  type         StockMovementType
  quantity     Int
  balanceAfter Int
  refType      String?
  refId        String?
  reason       String?           @db.Text
  userId       String?
  createdAt    DateTime          @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId, branchId, createdAt])
  @@index([restaurantId, productId, createdAt])
  @@index([restaurantId, type, createdAt])
  @@index([refType, refId])

  @@map("stockmovement")
}
