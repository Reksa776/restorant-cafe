// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  CASHIER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum NotificationType {
  ORDER_RECEIVED
  ORDER_CONFIRMED
  ORDER_PROCESSING
  ORDER_COMPLETED
  ORDER_CANCELLED
  PAYMENT_REQUEST
  PAYMENT_SUCCESS
  PAYMENT_FAILED
}

// ============================================================
// MODELS
// ============================================================

model User {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  email        String   @unique
  password     String
  role         Role     @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id])
  orderHistory OrderStatusHistory[]
  cashierShifts CashierShift[]
  auditLogs    AuditLog[]
  shiftOverridesRequested ShiftOverride[] @relation("ShiftOverrideRequester")
  shiftOverridesApproved  ShiftOverride[] @relation("ShiftOverrideApprover")
  shiftOverridesRejected  ShiftOverride[] @relation("ShiftOverrideRejecter")
  refundsRequested Refund[] @relation("RefundRequester")
  refundsApproved  Refund[] @relation("RefundApprover")
  refundsRejected  Refund[] @relation("RefundRejecter")
  cancellationsRequested CancellationRequest[] @relation("CancellationRequester")
  cancellationsApproved  CancellationRequest[] @relation("CancellationApprover")
  cancellationsRejected  CancellationRequest[] @relation("CancellationRejecter")

  @@map("user")
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  tables       Table[]
  categories   Category[]
  products     Product[]
  customers    Customer[]
  orders       Order[]
  payments     Payment[]
  cashierShifts CashierShift[]
  shiftOverrides ShiftOverride[]
  refunds      Refund[]
  cancellations CancellationRequest[]
  auditLogs    AuditLog[]

  @@map("restaurant")
}

model CashierShift {
  id           String      @id @default(cuid())
  restaurantId String
  userId       String
  shiftNumber  String
  openingCash  Decimal     @db.Decimal(12, 2)
  closingCash  Decimal?    @db.Decimal(12, 2)
  expectedCash Decimal?    @db.Decimal(12, 2)
  difference   Decimal?    @db.Decimal(12, 2)
  notes        String?     @db.Text
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  status       ShiftStatus @default(OPEN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  payments   Payment[]
  refunds    Refund[]
  overrides  ShiftOverride[]

  @@unique([restaurantId, shiftNumber])
  @@index([restaurantId])
  @@index([userId])
  @@index([status])

  @@map("cashiershift")
}

model ShiftOverride {
  id                    String        @id @default(cuid())
  restaurantId          String
  shiftId               String
  requestedByCashierId  String
  reason                String        @db.Text
  proposedClosingCash   Decimal?      @db.Decimal(12, 2)
  status                RequestStatus @default(PENDING)
  approvedByAdminId     String?
  rejectedByAdminId     String?
  decisionNote          String?       @db.Text
  requestedAt           DateTime      @default(now())
  decidedAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id])
  shift      CashierShift @relation(fields: [shiftId], references: [id])
  requester  User         @relation("ShiftOverrideRequester", fields: [requestedByCashierId], references: [id])
  approver   User?        @relation("ShiftOverrideApprover", fields: [approvedByAdminId], references: [id])
  rejecter   User?        @relation("ShiftOverrideRejecter", fields: [rejectedByAdminId], references: [id])

  @@index([restaurantId])
  @@index([shiftId])
  @@index([status])

  @@map("shiftoverride")
}

model Refund {
  id                    String        @id @default(cuid())
  restaurantId          String
  orderId               String
  paymentId             String?
  shiftId               String?
  amount                Decimal       @db.Decimal(12, 2)
  reason                String        @db.Text
  status                RequestStatus @default(PENDING)
  requestedByCashierId  String
  approvedByAdminId     String?
  rejectedByAdminId     String?
  decisionNote          String?       @db.Text
  requestedAt           DateTime      @default(now())
  decidedAt             DateTime?
  approvedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id])
  order      Order            @relation(fields: [orderId], references: [id])
  payment    Payment?         @relation(fields: [paymentId], references: [id])
  shift      CashierShift?    @relation(fields: [shiftId], references: [id])
  requester  User             @relation("RefundRequester", fields: [requestedByCashierId], references: [id])
  approver   User?            @relation("RefundApprover", fields: [approvedByAdminId], references: [id])
  rejecter   User?            @relation("RefundRejecter", fields: [rejectedByAdminId], references: [id])

  @@index([restaurantId])
  @@index([orderId])
  @@index([paymentId])
  @@index([status])
  @@index([shiftId])

  @@map("refund")
}

model CancellationRequest {
  id                    String        @id @default(cuid())
  restaurantId          String
  orderId               String
  reason                String        @db.Text
  status                RequestStatus @default(PENDING)
  requestedByCashierId  String
  approvedByAdminId     String?
  rejectedByAdminId     String?
  decisionNote          String?       @db.Text
  requestedAt           DateTime      @default(now())
  decidedAt             DateTime?
  approvedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  order      Order      @relation(fields: [orderId], references: [id])
  requester  User       @relation("CancellationRequester", fields: [requestedByCashierId], references: [id])
  approver   User?      @relation("CancellationApprover", fields: [approvedByAdminId], references: [id])
  rejecter   User?      @relation("CancellationRejecter", fields: [rejectedByAdminId], references: [id])

  @@index([restaurantId])
  @@index([orderId])
  @@index([status])

  @@map("cancellationrequest")
}

model AuditLog {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String?
  action       String
  entityType   String?
  entityId     String?
  details      Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])

  @@index([restaurantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])

  @@map("auditlog")
}


model Table {
  id           String      @id @default(cuid())
  restaurantId String
  number       Int
  name         String
  capacity     Int         @default(4)
  status       TableStatus @default(AVAILABLE)
  qrCode       String?     @db.Text
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  orders     Order[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
  @@index([status])

  @@map("table")
}

model Category {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String?  @db.Text
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  products   Product[]

  @@unique([restaurantId, name])
  @@index([restaurantId])

  @@map("category")
}

model Product {
  id           String   @id @default(cuid())
  restaurantId String
  categoryId   String
  name         String
  description  String?  @db.Text
  price        Decimal  @db.Decimal(10, 2)
  imageUrl     String?
  isAvailable  Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id])
  category     Category             @relation(fields: [categoryId], references: [id])
  orderItems   OrderItem[]
  optionGroups ProductOptionGroup[]
  addons       ProductAddon[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([isAvailable])

  @@map("product")
}

model Customer {
  id           String   @id @default(cuid())
  restaurantId String
  name         String?
  phone        String?
  whatsappId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  orders     Order[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@index([phone])

  @@map("customer")
}

model Order {
  id            String        @id @default(cuid())
  restaurantId  String
  orderNumber   String
  customerId    String
  tableId       String?
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  serviceCharge Decimal       @default(0) @db.Decimal(10, 2)
  grandTotal    Decimal       @db.Decimal(10, 2)
  orderType     OrderType     @default(DINE_IN)
  visitorCount  Int?
  notes         String?       @db.Text
  notifiedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id])
  customer      Customer             @relation(fields: [customerId], references: [id])
  table         Table?               @relation(fields: [tableId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  refunds       Refund[]
  cancellations CancellationRequest[]

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])

  @@map("order")
}

model ProductOptionGroup {
  id         String   @id @default(cuid())
  productId  String
  name       String
  type       String   @default("SINGLE") // SINGLE or MULTI
  isRequired Boolean  @default(true)
  minSelect  Int      @default(1)
  maxSelect  Int      @default(1)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@index([productId])

  @@map("productoptiongroup")
}

model ProductOption {
  id              String   @id @default(cuid())
  optionGroupId   String
  name            String
  priceAdjustment Decimal  @default(0) @db.Decimal(10, 2)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group ProductOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@index([optionGroupId])

  @@map("productoption")
}

model ProductAddon {
  id        String   @id @default(cuid())
  productId String
  name      String
  price     Decimal  @db.Decimal(10, 2)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])

  @@map("productaddon")
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(10, 2)
  totalPrice     Decimal  @db.Decimal(10, 2)
  notes          String?  @db.Text
  customizations Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])

  @@map("orderitem")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  notes     String?     @db.Text
  changedBy String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [changedBy], references: [id])

  @@index([orderId])
  @@index([status])

  @@map("orderstatushistory")
}

model Payment {
  id           String        @id @default(cuid())
  restaurantId String
  orderId      String
  // Cash drawer shift that collected this payment (KASIR only). Null for
  // online payments (QRIS/VA) and for legacy admin entries without a shift.
  shiftId      String?
  status       PaymentStatus @default(UNPAID)
  amount       Decimal       @db.Decimal(10, 2)
  method       String?
  provider     String?
  providerRef  String?
  paymentUrl   String?       @db.Text
  // Raw QR data returned by the gateway at payment-creation time (QRIS
  // channel). qrImage is the QR image (URL or data URI) from iPaymu;
  // qrString is the QR payload used only as a fallback to re-render.
  qrImage      String?       @db.Text
  qrString     String?       @db.Text
  paidAt       DateTime?
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id])
  order        Order                @relation(fields: [orderId], references: [id])
  shift        CashierShift?        @relation(fields: [shiftId], references: [id])
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([restaurantId])
  @@index([orderId])
  @@index([status])
  @@index([providerRef])
  @@index([shiftId])

  @@map("payment")
}

model PaymentTransaction {
  id        String   @id @default(cuid())
  paymentId String
  provider  String
  type      String
  status    String
  amount    Decimal  @db.Decimal(10, 2)
  rawData   Json?
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([provider])

  @@map("paymenttransaction")
}

model WhatsAppMessage {
  id           String   @id @default(cuid())
  restaurantId String
  direction    String // INCOMING | OUTGOING
  from         String
  to           String?
  messageId    String?  @unique
  content      String   @db.Text
  type         String? // text | image | etc
  status       String? // sent | delivered | read | failed
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([restaurantId])
  @@index([from])
  @@index([messageId])
  @@index([createdAt])

  @@map("whatsappmessage")
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  CONNECTING
  QR_REQUIRED
  CONNECTED
  RECONNECTING
  ERROR
}

model WhatsAppSession {
  id           String                   @id @default(cuid())
  restaurantId String                   @unique
  sessionId    String
  status       WhatsAppConnectionStatus @default(DISCONNECTED)
  phone        String? // Connected phone/JID
  lastError    String?                  @db.Text
  isActive     Boolean                  @default(true)
  lastActiveAt DateTime                 @default(now())
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([restaurantId])
  @@index([status])

  @@map("whatsappsession")
}

model Notification {
  id           String           @id @default(cuid())
  restaurantId String
  type         NotificationType
  title        String
  message      String           @db.Text
  data         Json?
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())

  @@index([restaurantId])
  @@index([isRead])
  @@index([createdAt])

  @@map("notification")
}
